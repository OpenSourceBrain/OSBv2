%% C4 Level 2 - Container diagram for OSB (OSBv2)
%% Aliases and external systems are reused verbatim from the Level 1 source
%%   (devdocs/system/c4-level1-osb-context.mmd).
%% INFERRED: `kubernetes` (the Kubernetes cluster / ingress platform) is inferred from
%%   deployment-configuration/values-template.yaml (mainapp osb-portal, tls true) and the
%%   nginx CORS ingress annotations in values-template-dev.yaml.
%% OUT OF SCOPE: the `events` and `workflows` dependencies listed by the workspaces app
%%   exist only as dependency names (no directory under applications/); they are
%%   upstream CloudHarness-provided and therefore NOT modelled as containers here.
%%   The event flow is expressed only as: notifications <- wsapi (CloudHarness events CDC).
C4Container
    title Container diagram for OSB (OSBv2)

    Person(registeredUser, "Registered user", "Researcher with an OSB account who builds and runs workspaces and notebooks")
    Person(anonymousVisitor, "Anonymous visitor", "Unauthenticated visitor browsing open workspaces and notebooks")
    Person(administrator, "Administrator", "Staff user administering workspaces, accounts and repositories")

    Container_Boundary(osb, "OSB") {
        Container(portal, "OSB Portal", "React SPA (Vite build) served by nginx :80", "Public web UI to browse repositories/workspaces and run notebooks; secured subdomain www, keycloak.json mounted, use_services workspaces + accounts-api, uri_role_mapping whitelists /login and /workspaces/open/*")
        Container(wsapi, "Workspaces API", "Python gunicorn/Flask/Connexion REST API :8080", "Manages workspaces and repositories and orchestrates copy jobs; postgres host, quotas, secrets github-user/github-token, depends on argo and accounts")
        Container(wsdb, "Workspaces database", "PostgreSQL 18", "Persistence for workspaces and repositories (host workspaces-postgres-host, database workspaces)")
        Container(accountsapi, "Accounts API", "Python Flask REST API :8080", "User/group/account queries for the frontends; subdomain api.accounts, /api/live and /api/ready, hard dependency on accounts")
        Container(keycloak, "Identity provider (accounts)", "Keycloak identity provider with its own PostgreSQL", "Authentication and authorisation, realms and tokens; only its database sizing is configured in-repo (harness.database resources); Keycloak role also evidenced by authenticator_class ch and portal keycloak.json")
        Container(hub, "JupyterHub", "JupyterHub hub + configurable-http-proxy (proxy-public :80), KubeSpawner", "Authenticates users and spawns/manages per-user notebook servers; subdomain hub, hard dependency on accounts, concurrent_spawn_limit 10, active_server_limit 40, spawner port 8000, storageClass {{namespace}}-nfs-client RWX, pvcNameTemplate osb-user-{userid}")
        Container(notebook, "JupyterLab single-user server", "JupyterLab image quay.io/jupyter/base-notebook:python-3.12, port 8000, home /opt/workspace", "The user's interactive notebook environment; subdomain lab (alias notebooks), service proxy-public:80, hard dependency on jupyterhub; alternative spawn images exist in-repo (netpyne, nwb-explorer, jupyterlab-minimal) as variants of this container")
        Container(workers, "Task worker images", "Short-lived container images run as Argo job pods: github-copy, dandi-copy, biomodels-copy, figshare-copy, scan-workspace", "Execute one-off data operations (clone/copy/scan) for workspaces and repositories")
        Container(argo, "Argo Workflows controller", "Argo Workflows controller (bundled chart values)", "Schedules and runs the task job pods with TTL and user-node scheduling defaults; workflowDefaults nodeAffinity hub.jupyter.org/node-purpose, tolerations, ttlStrategy 84600s; hard dependency of the workspaces app (ships only this chart values file)")
        Container(notifications, "Notifications service", "Python (cloudharness-base) service", "Sends notification email on workspace/repository creation; events.cdc subscription on app workspaces (workspace create, osbrepository create), channels admins/log, from-to info@opensourcebrain.org, secrets email-user/email-password")
        Container(nfs, "NFS server", "NFS server, 240Gi, export at /exports", "Shared RWX storage for user workspaces and notebook PVCs")
        Container(backoffice, "Backoffice", "Admin SPA served by nginx :80", "Admin UI over the workspaces and accounts APIs; subdomain admin, secured, use_services workspaces + accounts-api")
    }

    System_Ext(github, "GitHub", "Source code hosting")
    System_Ext(dandi, "DANDI Archive", "Neuroscience data archive")
    System_Ext(figshare, "Figshare", "Research data repository")
    System_Ext(biomodels, "BioModels (EBI)", "Model repository")
    System_Ext(smtp, "SMTP mail server", "Outbound email")
    System_Ext(kubernetes, "Kubernetes cluster", "Container platform providing ingress, scheduling and storage (INFERRED)")

    Rel(registeredUser, portal, "Uses", "HTTPS")
    Rel(anonymousVisitor, portal, "Uses open workspaces/notebooks", "HTTPS")
    Rel(administrator, backoffice, "Administers via", "HTTPS")

    Rel(portal, wsapi, "Calls", "REST, use_services")
    Rel(portal, accountsapi, "Calls", "REST, use_services")
    Rel(portal, keycloak, "Logs in users", "OpenID Connect, keycloak.json")
    Rel(portal, hub, "Embeds notebook UI", "soft dependency jupyterhub/jupyterlab")
    Rel(portal, kubernetes, "Served through ingress", "nginx, INFERRED")

    Rel(backoffice, wsapi, "Calls", "REST, use_services")
    Rel(backoffice, accountsapi, "Calls", "REST, use_services")

    Rel(wsapi, wsdb, "Reads/writes", "SQL")
    Rel(wsapi, argo, "Submits workflows", "hard dependency")
    Rel(wsapi, nfs, "Reads/writes shared images volume", "workspaces-images, RWX")

    Rel(argo, workers, "Runs as job pods", "container image")

    Rel(accountsapi, keycloak, "Queries/manages users", "admin API, hard dependency")

    Rel(hub, keycloak, "Authenticates via", "authenticator_class ch")
    Rel(hub, notebook, "Spawns and proxies", "KubeSpawner, port 8000")

    Rel(notebook, nfs, "Mounts per-user home", "PVC osb-user-{userid}, storageClass {{namespace}}-nfs-client, RWX")

    Rel(notifications, wsapi, "Receives change events", "CloudHarness events CDC, app workspaces")
    Rel(notifications, smtp, "Sends email", "SMTP port 587")

    Rel(workers, github, "Clones repositories", "git, token")
    Rel(workers, dandi, "Downloads/uploads dandiset assets", "DANDI API")
    Rel(workers, figshare, "Copies figshare resources", "figshare API")
    Rel(workers, biomodels, "Copies BioModels models", "BioModels API")

    UpdateLayoutConfig($c4ShapeInRow="3", $c4BoundaryInRow="1")
